# Application
APP_NAME=event-driven-task
APP_ENV=local
APP_PORT=8080

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=task_db
DB_SSLMODE=disable

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# JWT (dummy dulu)
JWT_SECRET=supersecret

# Email/SMTP Configuration
# Set USE_MOCK_EMAIL=true for development (logs email instead of sending)
# Set USE_MOCK_EMAIL=false for production (real email sending)
USE_MOCK_EMAIL=true

# SMTP Settings (only needed if USE_MOCK_EMAIL=false)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@taskhandler.com
SMTP_FROM_NAME=Task Handler

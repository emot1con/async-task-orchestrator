# Application
APP_NAME=event-driven-task
APP_ENV=local
APP_PORT=8080

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=task_db
DB_SSLMODE=disable

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# JWT (dummy dulu)
JWT_SECRET=supersecret

# Email/SMTP Configuration
# Set USE_MOCK_EMAIL=true for development (logs email instead of sending)
# Set USE_MOCK_EMAIL=false for production (real email sending)
USE_MOCK_EMAIL=true

# Primary SMTP Settings (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@taskhandler.com
SMTP_FROM_NAME=Task Handler

# Resend API Settings (Recommended for modern apps)
# Sign up at https://resend.com (Free tier: 3,000 emails/month, 100/day)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev
# For production, use verified domain: noreply@yourdomain.com

# Fallback SMTP Settings (optional, for VPS environments where port 587 is blocked)
# Option 1: Use SendGrid (https://sendgrid.com)
SMTP_FALLBACK_HOST=smtp.sendgrid.net
SMTP_FALLBACK_PORT=587
SMTP_FALLBACK_USERNAME=apikey
SMTP_FALLBACK_PASSWORD=your-sendgrid-api-key
SMTP_FALLBACK_FROM_EMAIL=noreply@yourdomain.com

# Option 2: Use Mailgun (https://www.mailgun.com)
# SMTP_FALLBACK_HOST=smtp.mailgun.org
# SMTP_FALLBACK_PORT=587
# SMTP_FALLBACK_USERNAME=postmaster@yourdomain.mailgun.org
# SMTP_FALLBACK_PASSWORD=your-mailgun-password

# Option 3: Use AWS SES (https://aws.amazon.com/ses/)
# SMTP_FALLBACK_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_FALLBACK_PORT=587
# SMTP_FALLBACK_USERNAME=your-aws-access-key
# SMTP_FALLBACK_PASSWORD=your-aws-secret-key
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@taskhandler.com
SMTP_FROM_NAME=Task Handler
